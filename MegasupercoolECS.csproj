<Project
   Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ECS</RootNamespace>
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
       Include="Newtonsoft.Json"
       Version="13.0.4"/>
    <PackageReference
       Include="OpenTK"
       Version="4.9.4"/>
  </ItemGroup>
  <ItemGroup>
    <None
       Include="**/*.dll"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
       Include="Shaders\**\*"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
       Include="Prototypes\**\*.json"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
       Include="**\*.png"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
       Include="**\*.jpg"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
       Include="**\*.gif"
       Exclude="bin\**; obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>